# webapp の環境変数サンプル。値はコード上のデフォルト（ローカル開発向け）。
# 秘密情報は空にしてあるので、各自の値を設定する。

# --- 各サービスの URL ---
PUBLIC_BASE_URL=http://localhost:3000
INTERNAL_BASE_URL=http://localhost:3000
PUBLIC_CONTENT_BASE_URL=http://localhost:9000/akashic-content/cdn
INTERNAL_CONTENT_BASE_URL=http://localhost:9000/akashic-content/cdn
SERVER_URL=http://localhost:3032
PUBLIC_STORAGE_URL=http://localhost:3031/playlog
INTERNAL_STORAGE_URL=http://localhost:3031/playlog

# --- OAuth プロバイダ（使うものだけ設定）---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- S3 / MinIO ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=akashic-content
S3_KEY_PREFIX=cdn/
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 伝言板・部屋チャットの監査ログ保管先
S3_AUDIT_BUCKET=akashic-audit
S3_AUDIT_KEY_PREFIX=
# 過去月スコアなどの非公開データ保管先
S3_ARCHIVE_BUCKET=akashic-archive
S3_ARCHIVE_KEY_PREFIX=

# --- SES（通報・問い合わせの運営通知メール送信）---
# SES_FROM_ADDRESS と SES_ADMIN_ADDRESS の両方が設定されたときだけ送信する（未設定なら DB 保存のみ）
SES_FROM_ADDRESS=
SES_ADMIN_ADDRESS=
SES_REGION=us-east-1
# ローカルの疑似 SES を使う場合のみ
SES_ENDPOINT=
SES_ACCESS_KEY=
SES_SECRET_KEY=

# --- OpenTelemetry（未設定なら送信しない）---
PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=
INTERNAL_OTEL_EXPORTER_OTLP_ENDPOINT=

# --- カスタムフッター / その他（任意）---
CUSTOM_FOOTER_HREF=
CUSTOM_FOOTER_LABEL=
CUSTOM_FOOTER_IMAGE_PATH=
CUSTOM_FOOTER_IMAGE_WIDTH=
NICONICOMMONS_WORK_URL=
# 段位ごとの既定の称号画像。{rank} は bronze / silver / gold に置き換わる
TITLE_RANK_IMAGE_URL_PATTERN=http://localhost:3000/image/rank/{rank}.png

# --- 挙動・上限 ---
GUEST_ROOM_LIMIT=5
CLIENT_LOG_CACHE_MAX_ENTRIES=1000
CLIENT_LOG_RATE_LIMIT_SECONDS=30
DRAIN_REFRESH_INTERVAL=5000
# ミュートの登録上限（1 利用者あたり）
MUTE_LIMIT=200
# BAN の登録上限（サインイン部屋主の全部屋あたり。ゲスト部屋主は対象外）
BAN_LIMIT=200

# --- 伝言板 レート制限 ---
BOARD_MESSAGE_TTL_MINUTES=30
BOARD_RATE_SHORT_WINDOW_SECONDS=30
BOARD_RATE_SHORT_MAX=10
BOARD_RATE_MEDIUM_WINDOW_SECONDS=600
BOARD_RATE_MEDIUM_MAX=60
BOARD_RATE_GLOBAL_PER_MINUTE=60

# --- 部屋チャット レート制限 ---
PLAY_CHAT_RATE_SHORT_WINDOW_SECONDS=10
PLAY_CHAT_RATE_SHORT_MAX=5
PLAY_CHAT_RATE_MEDIUM_WINDOW_SECONDS=60
PLAY_CHAT_RATE_MEDIUM_MAX=20
PLAY_CHAT_RATE_ROOM_PER_MINUTE=120
PLAY_CHAT_FETCH_LIMIT=200

# --- 通報 レート制限 ---
REPORT_RATE_GLOBAL_WINDOW_SECONDS=60
REPORT_RATE_GLOBAL_MAX=60
REPORT_RATE_SHORT_WINDOW_SECONDS=60
REPORT_RATE_SHORT_MAX=5
REPORT_RATE_MEDIUM_WINDOW_SECONDS=3600
REPORT_RATE_MEDIUM_MAX=30

# --- 問い合わせ レート制限 ---
CONTACT_RATE_GLOBAL_WINDOW_SECONDS=60
CONTACT_RATE_GLOBAL_MAX=20
CONTACT_RATE_SENDER_WINDOW_SECONDS=3600
CONTACT_RATE_SENDER_MAX=5
