{
  "name": "@multi-indiegame/external-api",
  "version": "0.1.0",
  "private": true,
  "description": "API for external platforms (AWS Lambda)",
  "files": [
    "CHANGELOG.md",
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "keywords": [],
  "scripts": {
    "clean": "rimraf ./dist ./bundle",
    "build": "tsc",
