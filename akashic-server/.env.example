PORT=3032
STORAGE_PUBLIC_URL=http://localhost:3031/playlog
STORAGE_ADMIN_URL=http://localhost:3033/playlog
STORAGE_ADMIN_TOKEN=
SERVER_WEBAPP_API_TOKEN=
RUNNER_URL=http://localhost:3034
RUNNER_SERVER_API_TOKEN=
SERVER_RUNNER_API_TOKEN=
MAX_PRESERVING_TICK_SIZE=0
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA"
PUBLIC_WEBAPP_URL=http://localhost:3000

# S3 / MinIO（content-log・client-log の保管）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=akashic-content
S3_KEY_PREFIX=cdn/
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# OpenTelemetry
OTEL_SERVICE_NAME=akashic-server
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# content-log でマスクする環境変数名を追加（カンマ区切り）
CONTENT_LOG_MASK_ENV=
